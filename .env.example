# umpomenfess-worker — contoh env.
# Copy menjadi .env untuk menjalankan worker di laptop. Di GitHub Actions
# nilai-nilai ini datang dari repository secrets; .env tidak dipakai dan
# tidak pernah di-commit.
#
# Semua nilainya dummy. Jangan tempel kredensial asli ke berkas ini.

# Postgres Supabase (connection string, bukan URL REST).
DATABASE_URL=postgres://user:password@host:5432/postgres

# Instagram Login (bukan Facebook Login). IG_USER_ID = id akun bisnis.
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=dummy-instagram-access-token

# Cloudinary — hanya worker yang memegang ini.
CLOUDINARY_CLOUD_NAME=dummy-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=dummy-secret

# Opsional. Jalankan `which chromium` (Linux) atau `which google-chrome`.
# Runner GitHub Actions tidak perlu ini karena Chrome sudah terpasang.
CHROME_PATH=
